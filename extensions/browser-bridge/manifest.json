{
  "manifest_version": 3,
  "name": "Provider account browser bridge",
  "version": "0.2.0",
  "description": "Transfers a browser session to the local usage monitor only during an account-add request.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://openai.com/*",
    "https://*.openai.com/*",
    "https://opencode.ai/*",
    "https://app.opencode.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Provider account bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["pairing.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["codex-auto-capture.js"],
      "run_at": "document_idle"
    }
  ]
}
